      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "conversation_short_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "is_group": {
            "default": false,
            "type": "boolean"
          },
          "native_user_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "maxLength": 4096,
            "format": "uri"
          },
          "width": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 32768
          },
          "height": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 32768
          },
          "image_type": {
            "type": "string",
            "enum": [
              "png",
              "gif",
              "webp",
              "jpeg"
            ]
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "native_user_id": "请替换为抖音数字UID",
            "name": "比心"
