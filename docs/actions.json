        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sec_user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "max_cursor": {
            "default": "0",
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "count": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "sec_user_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_get_user_posts_count",
      "description": "按数量聚合用户作品（最多 1000 条）",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sec_user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "target_count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "required": [
          "sec_user_id",
          "target_count"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_get_user_posts_page",
