          }
        },
        "required": [
          "native_user_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_fetch_stranger_messages",
      "description": "分页获取陌生人会话或指定会话的消息（不清除未读）",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "count": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "default": "0",
            "type": "string",
            "pattern": "^\\d{1,19}(?::\\d{1,6})?$"
          },
          "conversation_short_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          }
        },
        "additionalProperties": false
      }
    },
    {
      "action": "dy_send_stranger_msg",
      "description": "按 sec_user_id 创建会话并发送私信",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "sec_user_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "sec_user_id",
          "text"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_send_conversation_msg",
      "description": "按原生会话信息发送文本",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "conversation_short_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "is_group": {
            "default": false,
            "type": "boolean"
          },
          "native_user_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false,
        "examples": [
          {
            "native_user_id": "请替换为抖音数字UID",
            "text": "你好"
          }
        ]
      }
    },
    {
      "action": "dy_upload_image",
      "description": "上传私信图片并返回加密图片资源",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "image_base64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 22369641
          }
        },
        "required": [
          "image_base64"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_send_image",
      "description": "向会话发送已上传资源或 Base64 图片",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "conversation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "conversation_short_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "is_group": {
            "default": false,
            "type": "boolean"
          },
          "native_user_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "image_base64": {
            "type": "string",
            "minLength": 4,
            "maxLength": 22369641
          },
          "image": {
            "type": "object",
            "properties": {
              "oid": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "skey": {
                "type": "string",
                "pattern": "^[a-f\\d]{64}$"
              },
              "md5": {
                "type": "string",
                "pattern": "^[a-f\\d]{32}$"
              },
              "dataSize": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 16777216
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 32768
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 32768
              },
              "format": {
                "type": "string",
                "enum": [
                  "jpeg",
                  "png",
                  "gif",
                  "webp",
                  "heic"
                ]
              }
            },
            "required": [
              "oid",
              "skey",
              "md5",
              "dataSize",
              "width",
              "height"
            ],
            "additionalProperties": false
          }
        },
        "additionalProperties": false,
        "examples": [
          {
            "native_user_id": "请替换为抖音数字UID",
            "image_base64": "请替换为图片Base64内容"
          }
        ]
      }
    },
