            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "sec_user_id",
          "page"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_create_conversation",
      "description": "为原生用户 UID 创建私信会话",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
