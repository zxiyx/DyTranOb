    {
      "action": "dy_get_video_detail",
      "description": "读取作品原始详情与字幕轨道；网页失败时使用私信分享详情接口",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "aweme_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "conversation_short_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          }
        },
        "required": [
          "aweme_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_get_video_subtitles",
      "description": "读取作品原生字幕，返回纯文本和秒制时间轴（不执行语音识别）",
      "params": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "aweme_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "conversation_short_id": {
            "type": "string",
            "pattern": "^\\d{1,30}$"
          },
          "language": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "track_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 31
          }
        },
        "required": [
          "aweme_id"
        ],
        "additionalProperties": false
      }
    },
    {
      "action": "dy_get_user_info",
